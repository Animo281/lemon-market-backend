{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lemon-market-game",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../lemon-market-frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "exports": {
    "SessionDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "SessionDurableObject"
      }
    ]
  }
}
