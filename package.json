{
  "name": "lemons-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "build:frontend": "npm --prefix ../lemon-market-frontend run build",
    "typecheck:worker": "tsc -p tsconfig.worker.json && tsc -p tests/tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.mts",
    "test:all": "npm test && npm run test:worker",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.2.3",
    "@cloudflare/workers-types": "5.20260922.1",
    "@types/cors": "^2",
    "@types/express": "^4",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9",
    "@vitest/coverage-v8": "^4.1.4",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2",
    "typescript": "^5",
    "vitest": "^4.1.4",
    "wrangler": "4.136.3"
  }
}
